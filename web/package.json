{
  "name": "cs1conv-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "CS1 → CS2 converter: .cs1x preview, crop, road mapping and import package writer (web UI + Node CLI)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "cli": "node cli/cs1conv.ts",
    "docs": "node scripts/gen-docs.mjs",
    "notices": "node scripts/notices.mjs",
    "slim-catalogue": "node scripts/slim-catalogue.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
