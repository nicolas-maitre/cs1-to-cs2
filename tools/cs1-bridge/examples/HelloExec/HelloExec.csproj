<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Example `exec` library for the CS1 bridge (not a mod, not deployed). Build with `dotnet build`, then POST /rpc
      {"method":"exec","params":{"dll":"<abs path>\bin\Debug\net35\HelloExec.dll","method":"RunLater"}}
    The bridge loads the DLL's bytes on every call, so a rebuild takes effect without restarting the game.
  -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>HelloExec</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Required for hot reload on CS1: Mono 2 returns the already-loaded assembly when name AND version match, so
         `exec` would keep running the first build. A new version per build makes it load the new bytes. -->
    <Deterministic>false</Deterministic>
    <AssemblyVersion>1.0.*</AssemblyVersion>
    <NoWarn>$(NoWarn);CS7035</NoWarn>
    <!-- No symbols: CS1's Mono 2 only reads .mdb, the bridge would try (and fail) to load a .pdb next to the DLL. -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="mscorlib"><HintPath>$(CS1Managed)\mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(CS1Managed)\System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(CS1Managed)\System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(CS1Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ColossalManaged"><HintPath>$(CS1Managed)\ColossalManaged.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(CS1Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
