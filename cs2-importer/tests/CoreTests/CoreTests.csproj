<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game-free tests of the importer core (plan parsing, planning, curves, batching). `dotnet run` in this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\src\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\tools\bridge-common\MiniJson.cs" Link="Core\MiniJson.cs" />
  </ItemGroup>
</Project>
