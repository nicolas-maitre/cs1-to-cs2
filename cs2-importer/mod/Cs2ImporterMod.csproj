<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The user-facing CS2 importer mod (M2): Options page + ToolUpdate import system, on the same src/Core + src/Game code
    as the exec library (../Cs2Importer.csproj). `dotnet build -c Release` deploys it to the local Mods folder as
    Mods\Cs2Importer\Cs2ImporterMod.dll. Same build setup as tools/cs2-bridge: net48 against the game's Mono BCL
    (CS2Managed from ../../local.props), managed code only.
    Assembly name differs from the exec library ("Cs2Importer") so exec can still hot-load that one next to the mod.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Cs2ImporterMod</AssemblyName>
    <RootNamespace>Cs2ImporterMod</RootNamespace>
    <Version>0.3.1</Version>
    <Nullable>disable</Nullable>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CS2LocalMods Condition="'$(CS2LocalMods)' == ''">$(USERPROFILE)\AppData\LocalLow\Colossal Order\Cities Skylines II\Mods</CS2LocalMods>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\src\**\*.cs" Link="src\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\tools\bridge-common\MiniJson.cs" Link="src\MiniJson.cs" />
    <!-- buildings, objects, districts and surfaces steps (buildings/ worker), registered in Mod.OnLoad -->
    <Compile Include="..\..\buildings\src\**\*.cs" Link="buildings\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- transit lines (transit/ worker's exec library), driven by TransitStep.cs -->
    <Compile Include="..\..\transit\cs2-exec\*.cs" Link="transit\%(Filename)%(Extension)" />
    <!-- map preparation and outside connections (terrain/ worker's exec library), driven by MapSteps.cs -->
    <Compile Include="..\..\terrain\cs2-apply\*.cs" Link="terrain\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(CS2Managed)\mscorlib.dll" Private="false" />
    <Reference Include="$(CS2Managed)\netstandard.dll" Private="false" />
    <Reference Include="$(CS2Managed)\System.dll" Private="false" />
    <Reference Include="$(CS2Managed)\System.Core.dll" Private="false" />
    <Reference Include="$(CS2Managed)\System.IO.Compression.dll" Private="false" />
    <Reference Include="$(CS2Managed)\System.IO.Compression.FileSystem.dll" Private="false" />
    <Reference Include="$(CS2Managed)\Game.dll" Private="false" />
    <Reference Include="$(CS2Managed)\Colossal.Core.dll" Private="false" />
    <Reference Include="$(CS2Managed)\Colossal.Logging.dll" Private="false" />
    <Reference Include="$(CS2Managed)\Colossal.Mathematics.dll" Private="false" />
    <Reference Include="$(CS2Managed)\Colossal.Collections.dll" Private="false" />
    <Reference Include="$(CS2Managed)\Colossal.IO.AssetDatabase.dll" Private="false" />
    <Reference Include="$(CS2Managed)\Colossal.AssetPipeline.dll" Private="false" />
    <Reference Include="$(CS2Managed)\Colossal.Localization.dll" Private="false" />
    <Reference Include="$(CS2Managed)\Colossal.UI.Binding.dll" Private="false" />
    <Reference Include="$(CS2Managed)\Colossal.PSI.Common.dll" Private="false" />
    <Reference Include="$(CS2Managed)\Unity.Entities.dll" Private="false" />
    <Reference Include="$(CS2Managed)\Unity.Mathematics.dll" Private="false" />
    <Reference Include="$(CS2Managed)\Unity.Collections.dll" Private="false" />
    <Reference Include="$(CS2Managed)\Unity.Burst.dll" Private="false" />
    <Reference Include="$(CS2Managed)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
  <Target Name="DeployToCS2" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(CS2LocalMods)\Cs2Importer" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CS2LocalMods)\Cs2Importer" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(CS2LocalMods)\Cs2Importer" />
  </Target>
</Project>
